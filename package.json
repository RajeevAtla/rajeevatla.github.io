{
	"name": "new-website",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bunx --bun vite",
		"build": "bunx --bun vite build",
		"preview": "bunx --bun vite preview",
		"prepare": "bunx --bun svelte-kit sync",
		"check": "bunx --bun svelte-kit sync && bunx --bun svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bunx --bun svelte-kit sync && bunx --bun svelte-check --tsconfig ./tsconfig.json --watch",
		"biome:check": "bunx --bun biome ci src vite.config.ts postcss.config.cjs tailwind.config.ts",
		"biome:format": "bunx --bun biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.2",
		"@tailwindcss/postcss": "^4.3.3",
		"postcss": "^8.5.31",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.5"
	},
	"dependencies": {
		"daisyui": "^5.7.50"
	}
}
